# Development defaults. Docker Compose loads this file automatically.
# (Committed on purpose so `docker compose up` works right after cloning;
#  never commit real production secrets.)

# --- Public entry point ---
GATEWAY_PORT=8080
GATEWAY_REQUEST_TIMEOUT=10s

# --- Service B: Telescope service ---
TELESCOPE_GRPC_PORT=50051
TELESCOPE_DB_USER=telescope_user
TELESCOPE_DB_PASSWORD=telescope_pw
TELESCOPE_DB_NAME=telescopes_db

# --- Service A: Session service ---
SESSION_GRPC_PORT=50052
SESSION_DB_USER=session_user
SESSION_DB_PASSWORD=session_pw
SESSION_DB_NAME=sessions_db

# --- Resilience: Session -> Telescope call ---
# per-attempt timeout
TELESCOPE_TIMEOUT=2s
# retries after the first attempt (3 attempts total)
TELESCOPE_MAX_RETRIES=2
# 200ms, 400ms, ... (+ jitter)
TELESCOPE_RETRY_BACKOFF=200ms
# consecutive failures before the breaker opens
BREAKER_FAILURE_THRESHOLD=5
# how long it stays open before probing again
BREAKER_OPEN_DURATION=10s
