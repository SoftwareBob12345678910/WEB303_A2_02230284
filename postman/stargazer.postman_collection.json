    {
      "name": "4. Resilience (run AFTER: docker compose stop telescope-service)",
      "description": "Stop Service B first. Create fails fast with 503 (retries then circuit breaker); Get degrades gracefully with telescope_details_available=false.",
      "item": [
        {
          "name": "Create session while Service B is down -> 503",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telescope_id\": \"{{telescopeId}}\",\n  \"observer\": \"Chen\",\n  \"date\": \"{{sessionDate2}}\"\n}",
