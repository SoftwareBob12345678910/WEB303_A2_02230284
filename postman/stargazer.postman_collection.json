{
  "info": {
    "name": "Stargazer - Telescopes & Observation Sessions",
    "description": "Run folders 1,2,3 in order with the full stack up. Run folder 4 after `docker compose stop telescope-service`, then `docker compose start telescope-service` and run 5. All requests go through the API gateway only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "telescopeId",
      "value": ""
    },
    {
      "key": "maintenanceId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "sessionDate",
      "value": ""
    },
    {
      "key": "sessionDate2",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pick bookable dates in the future so validation never rejects them.",
          "function iso(days){ const d = new Date(); d.setDate(d.getDate()+days); return d.toISOString().slice(0,10); }",
          "if (!pm.collectionVariables.get('sessionDate'))  pm.collectionVariables.set('sessionDate', iso(30));",
          "if (!pm.collectionVariables.get('sessionDate2')) pm.collectionVariables.set('sessionDate2', iso(31));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Telescopes (Service B)",
      "item": [
        {
          "name": "Create telescope",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/telescopes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "telescopes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dobsonian 8\",\n  \"aperture_mm\": 203,\n  \"type\": \"REFLECTOR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"telescopeId\", pm.response.json().id);",
                  "pm.test(\"Defaults to AVAILABLE\", function(){ pm.expect(pm.response.json().status).to.eql(\"AVAILABLE\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List telescopes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/telescopes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "telescopes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get telescope",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/telescopes/{{telescopeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "telescopes",
                "{{telescopeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update telescope (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/telescopes/{{telescopeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "telescopes",
                "{{telescopeId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dobsonian 8 (collimated)\",\n  \"aperture_mm\": 203,\n  \"type\": \"REFLECTOR\",\n  \"status\": \"AVAILABLE\"\n}",
              "options": {
